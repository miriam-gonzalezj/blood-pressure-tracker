<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta blanca con borde suave y esquinas redondeadas: envuelve cada
     sección del resumen (estadísticas, mañana/noche, tendencia) para dar
     separación visual clara sin usar líneas pesadas. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/report_card_bg" />
    <stroke android:width="1dp" android:color="@color/report_card_border" />
    <corners android:radius="14dp" />
</shape>
